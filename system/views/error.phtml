<script nonce="<?= $request?->session()?->get('csp_nonce') ?>">
    function copyError() {
        // PHP variables injected here for JS use
        const errorTitle = "<?= addslashes(get_class($exception)) ?>: <?= addslashes($exception->getMessage()) ?>";
        const location = "<?= addslashes($exception->getFile()) ?> line <?= $exception->getLine() ?>";
        const fullText = `${errorTitle}\n${location}`;

        const textArea = document.createElement('textarea');
        textArea.value = fullText;
        document.body.appendChild(textArea);
        textArea.select();

        try {
            document.execCommand('copy');
            const btn = document.querySelector('.btn-copy');
            const originalText = btn.innerText;

            btn.innerText = "Copied!";
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerText = originalText;
                btn.classList.remove('btn-success');
            }, 2000);
        } catch (err) {
            console.error('Failed to copy', err);
        }

        document.body.removeChild(textArea);
    }

    // Attach the event listener programmatically
    document.getElementById('copy-error-btn').addEventListener('click', copyError);
</script>
