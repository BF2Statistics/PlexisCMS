                    <span style="font-size: 0.75rem; color: #6b7280; font-weight: normal; background: #f3f4f6; padding: 2px 8px; border-radius: 10px; border: 1px solid #e5e7eb;">Latest First</span>
                </div>
                <ul class="trace-list">
                    <?php
                    use System\Diagnostics\ErrorHighlighter;
                    $trace = $exception->getTrace();

                    // Helper to format arguments recursively with indentation
                    $renderArg = function($var, $depth = 0) use (&$renderArg)
                    {
                        if (is_array($var))
                        {
                            if (empty($var)) return '[]';
                            if ($depth >= 4) return 'array(' . count($var) . ')';

                            $indent = str_repeat("&nbsp;", ($depth + 1) * 4);
                            $html = "[<br>";
                            $count = 0;
                            foreach ($var as $key => $val)
                            {
                                if ($count >= 25) {
                                    $html .= $indent . "&nbsp;&nbsp;&nbsp;&nbsp;...<br>";
                                    break;
                                }
                                $keyStr = htmlspecialchars(is_string($key) ? "'$key'" : $key);
                                $html .= $indent . "&nbsp;&nbsp;&nbsp;&nbsp;" . $keyStr . " => " . $renderArg($val, $depth + 1) . ",<br>";
                                $count++;
                            }
                            $html .= $indent . "]";
                            return $html;
                        }
                        return htmlspecialchars(self::DescribeVar($var));
                    };

                    // Determine if the error originated from within the ErrorHandler itself
                    $isInternalError = false;
                    if (str_contains($exceptionFile, 'system' . DS . 'framework' . DS . 'Diagnostics' . DS . 'ErrorHandler.php')) {
                        $isInternalError = true;
                    }

                    $i = 0;
                    foreach ($trace as $frame):
                        // Skip ErrorHandler frames unless the error actually happened there
                        $class = $frame['class'] ?? '';
                        if (!$isInternalError && $class === 'System\Diagnostics\ErrorHandler') continue;

                        $i++;
                        $type = $frame['type'] ?? '';
                        $function = $frame['function'] ?? '';
                        $file = $frame['file'] ?? 'internal';
                        $fileEditorPath = ($editorRemoveRoot) ? str_replace(ROOT, '', $file) : $file;
                        $line = $frame['line'] ?? '-';
                        $hasArgs = !empty($frame['args']);

                        // FIX: If the TOP frame (i=1) has missing file info (Reflection),
                        /* assume it corresponds to the actual Exception location.
                        if ($i === 1 && $file === 'internal')
                        {
                            $file = $exception->getFile();
                            $line = $exception->getLine();
                        }
                        */

                        // Format arguments using helper
                        $argsDisplay = [];
                        if ($hasArgs)
                        {
                            foreach ($frame['args'] as $arg)
                            {
                                $argsDisplay[] = $renderArg($arg);
                            }
                        }

                        // Get snippet for trace (if file exists)
                        $tracePreview = null;
                        if ($file !== 'internal' && file_exists($file))
                        {
                            // Only fetch snippet if we have valid line number
                            if (is_numeric($line) && $line > 0) {
                                $tracePreview = ErrorHighlighter::GetSnippet($file, $line, 5); // 5 lines padding
                            }
                        }
                        ?>
                        <li class="trace-item">
                            <?php if ($hasArgs || $tracePreview): ?>
