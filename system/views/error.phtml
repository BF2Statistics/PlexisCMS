                                    <summary>
                                        <div class="trace-method">
                                            <div style="display:flex; align-items:center; gap: 0.5rem;">
                                                <svg class="chevron" width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                </svg>
                                                <span><?= htmlspecialchars($class . $type . $function) ?></span>
                                            </div>
                                            <span class="frame-badge">Frame #<?= $i ?></span>
                                        </div>
                                        <div class="trace-file trace-file-indented">
                                            <?= htmlspecialchars($file) ?> <span style="color:#9ca3af;">:</span> <span style="font-weight:bold; color:#1f2937;"><?= $line ?></span>
                                            <?php if ($file !== 'internal'): ?>
                                                <a href="<?= sprintf($editorProtocol, $fileEditorPath, $line) ?>" class="vscode-link" title="Open in Editor">
                                                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                                </a>
                                            <?php endif; ?>
                                        </div>
                                    </summary>

                                    <div style="padding-top: 0.5rem; padding-left: 22px;">
                                        <?php if ($hasArgs): ?>
                                            <div class="trace-arg-box" style="margin-bottom: 0.5rem;">
                                                <span style="color:#6b7280; font-size: 0.75rem; font-weight: bold; display: block; margin-bottom: 4px;">Arguments:</span>
                                                <?php
                                                // Only use block formatting if an argument is multiline (contains <br>)
                                                // Otherwise display inline comma separated
                                                $isMultiline = false;
                                                foreach($argsDisplay as $ad)
                                                {
                                                    if (strpos($ad, '<br>') !== false)
