<article class="grid_12">
	<section class="grid_12 error-page">
		<h1>404</h1>
		<p>Page not found</p>
	</section>
	<section class="grid_12">
		<div class="relative" style="max-width: 20%; margin: 0 auto;">
			<!-- Tabs on the left -->
			<ul class="action-tabs with-children-tip children-tip-left">
				<li><a href="javascript:history.back()" title="Go back"><img src="{base_url}/public/images/icons/fugue/navigation-180.png" width="16" height="16"></a></li>
			</ul>

			<!-- Tabs on the right -->
			<ul class="action-tabs right with-children-tip children-tip-right">
				<li><a href="#" title="Contact support"><img src="{base_url}/public/images/icons/fugue/mail.png" width="16" height="16"></a></li>
			</ul>

			<div class="block-border no-title">
				<div class="block-content dark-bg">
					<p>
						The page you are looking for does not exist. If you feel that you have reached this page
						in error, please contact support by clicking the mail icon on the right. You may also click the
						icon on the left to go back to the previous page.
					</p>
					<p>Error Message: {message}</p>
				</div>
			</div>
		</div>
	</section>
</article>